{
  "productName": "ClassInDL",
  "version": "1.0.0",
  "identifier": "com.classin-dl.tool",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1682"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ClassIn Video Downloader",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 450,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}