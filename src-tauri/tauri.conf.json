{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClassIn Video Downloader",
  "version": "2.0.0",
  "identifier": "com.classin.downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:8899",
    "frontendDist": "../src/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClassIn Video Downloader",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "decorations": true,
        "center": true,
        "theme": null,
        "visible": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.svg"],
    "targets": "all"
  }
}